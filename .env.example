# ──────────────────────────────────────────────────
# Dominio canonical / SEO
# ──────────────────────────────────────────────────

# Dominio final del sitio.
# No usar localhost ni dominios temporales de Vercel en producción.
# Debe coincidir con el dominio principal configurado en Vercel.
NEXT_PUBLIC_SITE_URL=https://karincadenaseventos.com


# ──────────────────────────────────────────────────
# Sanity CMS — Variables de entorno
# ──────────────────────────────────────────────────

# ID del proyecto en Sanity.
# Se obtiene en manage.sanity.io → Project → Project ID.
NEXT_PUBLIC_SANITY_PROJECT_ID=

# Dataset de Sanity.
# Normalmente es "production".
NEXT_PUBLIC_SANITY_DATASET=production

# Versión de la API de Sanity.
# Formato recomendado: YYYY-MM-DD.
NEXT_PUBLIC_SANITY_API_VERSION=2024-01-01

# Token de lectura.
# Solo es necesario si el dataset NO es público o si haces consultas privadas desde el servidor.
# Se genera en manage.sanity.io → API → Tokens.
SANITY_API_READ_TOKEN=

# Token de escritura.
# Solo usar si el proyecto tiene scripts, seeds o acciones del servidor que escriben en Sanity.
# No debe usarse en componentes del cliente.
SANITY_API_WRITE_TOKEN=


# ──────────────────────────────────────────────────
# WhatsApp
# ──────────────────────────────────────────────────

# Número fallback si Sanity no tiene configurado el número.
# Formato: código de país + número, sin +, espacios ni guiones.
NEXT_PUBLIC_WHATSAPP_NUMBER=51922459810


# ──────────────────────────────────────────────────
# Revalidación / caché de Sanity
# ──────────────────────────────────────────────────

# Secreto para proteger /api/revalidate.
# Debe ser exactamente el mismo en Vercel y en la URL del webhook de Sanity.
# Ejemplo de webhook:
# https://karincadenaseventos.com/api/revalidate?secret=TU_SECRET
SANITY_REVALIDATE_SECRET=

# Tiempo máximo de caché ISR en producción si el webhook no se ejecuta.
# 60 = el sitio puede tardar hasta 1 minuto en refrescar contenido como respaldo.
SANITY_REVALIDATE_SECONDS=60

# Para pruebas locales con npm run build && npm run start.
# true  = evita caché de Sanity y permite ver cambios más rápido en local.
# false = comportamiento normal de producción.
# En Vercel/producción debe ser false.
SANITY_DISABLE_CACHE=false
